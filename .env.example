# Copy this file to .env and fill in real values locally.
# .env is gitignored and must NEVER be committed.
# No key in this file should ever be a real value — this file only documents
# which variables exist, not what they contain.

# --- Application ---
APP_ENV=development
APP_SECRET_KEY=changeme-generate-a-random-value
# The app's own public origin — CORS is locked to exactly this
# (deployment.md). Local default matches uvicorn's default port.
APP_BASE_URL=http://localhost:8000

# --- LLM Provider ---
# Anthropic is the sole LLM provider for the MVP (ADR-001, ADR-005).
ANTHROPIC_API_KEY=

# --- Database ---
# Supabase Postgres in production (ADR-005). Locally, defaults to the
# docker-compose Postgres (docker compose up -d) — its password is a
# fixed, non-secret local-only default (see docker-compose.yml), so the
# local default below is intentionally not a placeholder to fill in.
DATABASE_URL=postgresql+psycopg://vendor_dd:local_dev_only_not_a_real_secret@localhost:5437/vendor_dd

# --- Observability ---
# Langfuse: LLM tracing, token usage, cost, latency. Document text is
# redacted/truncated before being sent — see docs/observability.md.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Sentry: application/runtime error tracking.
SENTRY_DSN=

# --- Reviewer auth ---
# Single-reviewer basic auth for the human-review UI. No multi-user roles
# in the MVP — see docs/architecture.md.
REVIEWER_USERNAME=
REVIEWER_PASSWORD=

# --- Cost controls ---
# Locked after the Phase 6 single-agent baseline is measured, per ADR-006
# and decision #11 — do not set an arbitrary number before that data exists.
MAX_CASE_COST_USD=
