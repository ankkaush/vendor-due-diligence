# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# --- Virtual environments ---
.venv/
venv/
env/

# --- Environment variables (never commit real secrets) ---
.env
.env.*
!.env.example

# --- IDE / editor ---
.vscode/
.idea/
*.swp

# --- OS ---
.DS_Store
Thumbs.db

# --- Testing / linting caches ---
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Logs ---
*.log

# --- Local data (uploaded/synthetic evidence documents must never be committed by accident) ---
/data/uploads/
/data/local/

# --- Local database files ---
*.sqlite3
*.db

# --- Secret scanning baseline, if ever generated locally ---
.secrets.baseline
